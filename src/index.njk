---
layout: layouts/base.njk
title: Home
---
<section class="hero wrapper">
  <p class="hero__eyebrow">Product &amp; Interaction Designer</p>
  <h1 class="hero__title">Saya mendesain sistem, bukan cuma layar.</h1>
  <p class="hero__lede">
    Fokus saya ada di tiga hal: menyelesaikan masalah lewat case study,
    membangun design system yang scalable, dan menghidupkan interface
    lewat motion UI.
  </p>
</section>

<section class="section wrapper">
  <h2>Case Study Terbaru</h2>
  <div class="grid" style="margin-top: var(--space-l);">
    {% for item in collections.caseStudies %}
      {% if loop.index <= 3 %}
        <a class="card" href="{{ item.url }}">
          <div class="frame card__frame">
            <img src="{{ item.data.cover }}" alt="{{ item.data.title }}" loading="lazy">
          </div>
          <h3 class="card__title">{{ item.data.title }}</h3>
          <p class="card__meta">{{ item.data.role }} · {{ item.data.year }}</p>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>


<section class="section section--paper">
  <div class="wrapper">
    <p class="section-index">05 / about</p>
    <div class="about-grid" style="margin-top: var(--space-m);">
      <div class="flow">
        <h2>{{ meta.about.heading }}</h2>
        {% for paragraph in meta.about.paragraphs %}
          <p>{{ paragraph }}</p>
        {% endfor %}
      </div>

      <div class="stats-panel">
        <div class="stats-panel__header">by the numbers</div>
        {% for stat in meta.about.stats %}
          <div class="stats-panel__row">
            <span>{{ stat.label }}</span>
            <span class="stats-panel__value">{{ stat.value }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section class="contact">
  <div class="wrapper">
    <p class="section-index">06 / contact</p>
    <div class="contact__grid" style="margin-top: var(--space-m);">
      <div>
        <h2>{{ meta.contact.heading }}</h2>
        <p class="contact__lede">{{ meta.contact.lede }}</p>
        <div class="contact__actions">
          <a class="btn btn--primary" href="mailto:{{ meta.contact.email }}">{{ meta.contact.email }}</a>
          <a class="btn btn--ghost" href="{{ meta.contact.linkedin }}" target="_blank" rel="noopener">linkedin ↗</a>
        </div>
      </div>
      <img class="contact__avatar" src="{{ meta.contact.avatar }}" alt="Foto profil">
    </div>
  </div>
</section>