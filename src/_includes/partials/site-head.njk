<header class="site-head">
  <div class="site-head__inner">
    {% set name = meta.siteName or "Rodetyo Prast" %}
    {% set firstLetter = name | truncate(1, true, "") %}
    {% set restOfName = name | replace(firstLetter, "", 1) %}

    <a class="logo" href="/" aria-label="{{ name }}">
      <span class="logo__first">{{ firstLetter }}</span><span class="logo__rest">{{ restOfName }}</span>
    </a>

    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Ganti tema gelap/terang">
      <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
  </div>
</header>